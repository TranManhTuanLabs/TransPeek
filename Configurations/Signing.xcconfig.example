// Code Signing Configuration
// Copy this file to Signing.xcconfig and fill in your values.
// Use TRANSPEEK_ prefix to avoid being overridden by Tuist defaults.

TRANSPEEK_CODE_SIGN_STYLE = Manual
TRANSPEEK_CODE_SIGN_IDENTITY = Apple Development: YOUR_NAME (YOUR_TEAM_ID)
TRANSPEEK_DEVELOPMENT_TEAM = YOUR_TEAM_ID

// Sparkle EdDSA public key for auto-update verification (optional for development)
// Generate with: ./bin/generate_keys (from Sparkle distribution)
// SPARKLE_ED_PUBLIC_KEY =
